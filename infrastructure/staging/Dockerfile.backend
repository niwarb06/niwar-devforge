FROM python:3.12.13-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

RUN groupadd --gid 10001 devforge \
    && useradd \
      --uid 10001 \
      --gid devforge \
      --no-create-home \
      --home-dir /app \
      --shell /usr/sbin/nologin \
      devforge

COPY packages/backend-core/pyproject.toml ./pyproject.toml
COPY packages/backend-core/alembic.ini ./alembic.ini
COPY packages/backend-core/src ./src
COPY packages/backend-core/migrations ./migrations

RUN python -m pip install --no-cache-dir --upgrade pip \
    && python -m pip install --no-cache-dir .

USER 10001:10001

EXPOSE 8000

CMD ["python", "-m", "uvicorn", "devforge_core.main:app", "--host", "0.0.0.0", "--port", "8000"]
