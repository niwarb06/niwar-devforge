# Copy to /etc/niwar-devforge/staging-monitor.env with mode 0600.
# Never commit the real alert destination or bearer credential.
STAGING_PUBLIC_ORIGIN=https://staging.example.com
STAGING_ALERT_WEBHOOK_URL=https://alerts.example.com/devforge-staging
# Optional bearer token supplied only if the chosen alert endpoint requires it.
# STAGING_ALERT_WEBHOOK_BEARER=replace-on-host-only
