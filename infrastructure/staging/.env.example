# Public DNS name owned by the staging deployment.
STAGING_HOST=staging.example.com
STAGING_PUBLIC_ORIGIN=https://staging.example.com

# Secret files are created on the deployment host with mode 0600 and are never committed.
STAGING_POSTGRES_PASSWORD_FILE=/srv/niwar-devforge/staging/secrets/postgres_password
STAGING_REDIS_PASSWORD_FILE=/srv/niwar-devforge/staging/secrets/redis_password

# Optional immutable image references for a registry-backed release/rollback.
STAGING_BACKEND_IMAGE=niwar-devforge/backend-staging:local
STAGING_WEB_IMAGE=niwar-devforge/web-staging:local

# Optional host bind overrides. Defaults are 80/443.
STAGING_HTTP_BIND=80
STAGING_HTTPS_BIND=443

# Use ./Caddyfile for real staging. CI overrides this with ./Caddyfile.ci.
STAGING_CADDYFILE=./Caddyfile
