{
  "name": "@niwar-devforge/web-bff-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Reusable same-origin web BFF auth transport for Niwar DevForge generated products.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "MODULE.md",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "typescript": "5.9.2"
  }
}
