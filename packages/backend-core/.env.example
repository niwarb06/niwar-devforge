DEVFORGE_APP_NAME=Niwar DevForge API
DEVFORGE_ENVIRONMENT=development
DEVFORGE_API_PREFIX=/api/v1
DEVFORGE_DATABASE_URL=postgresql+psycopg://<user>:<password>@localhost:5432/<database>
DEVFORGE_REDIS_URL=redis://localhost:6379/0
DEVFORGE_CORS_ORIGINS=[]
DEVFORGE_LOG_LEVEL=INFO
DEVFORGE_SESSION_TTL_MINUTES=10080
DEVFORGE_CREDENTIAL_RATE_LIMIT_WINDOW_SECONDS=60
DEVFORGE_LOGIN_IP_LIMIT=10
DEVFORGE_LOGIN_IDENTIFIER_LIMIT=5
DEVFORGE_REGISTER_IP_LIMIT=5
DEVFORGE_REGISTER_IDENTIFIER_LIMIT=3
